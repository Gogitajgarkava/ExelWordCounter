{
  "name": "excel-word-counter",
  "version": "2.0.0",
  "private": true,
  "description": "Excel ტექსტის ანალიზატორი — სიტყვების, სიმბოლოებისა და სიხშირის დათვლა ბრაუზერში.",
  "scripts": {
