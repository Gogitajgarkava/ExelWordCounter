    "dev": "tailwindcss -i ./src/styles.css -o ./css/app.css --watch",
    "serve": "npx serve .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "type": "module"
}
